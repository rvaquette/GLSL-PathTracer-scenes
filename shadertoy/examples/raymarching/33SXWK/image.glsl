void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
    float time = iTime * 0.25+1.0;
    
    vec3 viewDir = normalize(vec3((fragCoord.xy - iResolution.xy*0.5) / iResolution.y, 1.0));
    
    vec3 camUp = vec3(0,1,0);
    vec3 camTarget = vec3(30,50,9);
    vec3 camPos = camTarget + vec3(cos(time)*150.0,50.0,sin(time)*150.0);
    
    vec3 forward = normalize(camTarget - camPos);
    vec3 left = normalize(cross(forward, camUp));
    vec3 up = cross(left, forward);

    mat3 viewToWorld = mat3(left, up, forward);
    
    vec3 worldDir = viewToWorld * viewDir;
    
    vec3 worldNormal;
    float t = intersectMesh(camPos, worldDir, worldNormal);

    vec3 color = vec3(.45,.5,.55) + vec3(.3,.4,.5)*worldDir.y;
    if(t < MAX_DIST)
    {
        const vec3 lightDir = normalize(vec3(1,.9,.3));
        color = max(.1 + .9*dot(worldNormal,lightDir),0.)*vec3(1.1,.85,.6);
        color += (.5 + .5*worldNormal.y)*vec3(.1,.2,.4)*.375;
        color += max(.4 + .6*dot(worldNormal,lightDir*vec3(-1,1,-1)),0.)*0.0875;
        color += vec3(.03);  
        color *= .8;
    }

#if SHOW_HIERARCHY && USE_HIERARCHY
    color += numNodesVisited*.02;
#endif
    
    fragColor = vec4(pow(color,vec3(.4545)),1.);
}
