// Tracing of 292 polygon Stanford bunny in pure GLSL.

// A hardcoded bounding volume hierarchy is used to speed up the trace.
// By doing this we are effectively encoding the bounding volume tree in the
// Abstract Syntax Tree :)

// Unfortunately, at this point the compilation times seem like more of showstopper
// than the actual tracing performance (yet again). It is possible that the compilation
// time can be improved by massaging the code or by going multipass. 

// The triangle intersection test uses Plücker coordinates, which
// seem particularly well suited for this use case. The Plücker coordinates
// for the edges can be precomputed and the Plücker coordinates for the ray
// can be shared between all triangles. The intersection test itself then
// reduces to just 6 dot products.

#define USE_HIERARCHY 1
#define SHOW_HIERARCHY 1
#define USE_PLUCKER_COORDINATES 1

const float MAX_DIST = 1000.0;

bool intersectBox(vec3 pos, vec3 invDir, vec3 mn, vec3 mx, float t)
{
#if USE_HIERARCHY
    vec3 t0 = (mn - pos) * invDir;
    vec3 t1 = (mx - pos) * invDir;
    
    float tmin = max(max(min(t0.x, t1.x), min(t0.y, t1.y)), min(t0.z,t1.z));
    float tmax = min(min(max(t0.x, t1.x), max(t0.y, t1.y)), max(t0.z,t1.z));
    return tmax >= tmin && tmin < t;
#else
    return true;
#endif
}

#if USE_PLUCKER_COORDINATES
void intersect_triangle(vec3 pos, vec3 dir, vec3 v0, vec3 v1, vec3 v2, inout float min_t, out vec3 outNormal)
{
    // Can be shared between all triangles
    vec3 center_u = dir;
    vec3 center_v = cross(dir, pos);
    
    // Constant
    vec3 v0_u = (v1 - v0);
    vec3 v0_v = cross(v1, v0);
    
    vec3 v1_u = (v2 - v1);
    vec3 v1_v = cross(v2, v1);
    
    vec3 v2_u = (v0 - v2);
    vec3 v2_v = cross(v0, v2);
    
    vec3 normal = normalize(cross(v1 - v0, v2 - v0));
    float q = dot(dir, normal);
    
    // 6 dot intersection test
    if(dot(v0_u, center_v) + dot(v0_v, center_u) > 0.0 &&
       dot(v1_u, center_v) + dot(v1_v, center_u) > 0.0 &&
       dot(v2_u, center_v) + dot(v2_v, center_u) > 0.0)
    {
        
        float t = -dot(pos - v0, normal) / q;
        if(t < min_t)
        {
            outNormal = normal;
            min_t = t;
        }
    }
}

#else
float tripleProduct(vec3 a, vec3 b, vec3 c)
{
    return dot(a, cross(b, c));
}
void intersect_triangle(vec3 pos, vec3 dir, vec3 v0, vec3 v1, vec3 v2, inout float min_t, out vec3 outNormal)
{
    if(tripleProduct(v0 - pos, v1 - pos, dir) < 0.0 && tripleProduct(v1 - pos, v2 - pos, dir) < 0.0 && tripleProduct(v2 - pos, v0 - pos, dir) < 0.0)
    {
        vec3 normal = normalize(cross(v1 - v0, v2 - v0));
        float t = -dot(pos - v0, normal) / dot(dir, normal);
        if(t < min_t)
        {
            outNormal = normal;
            min_t = t;
        }
    }
}
#endif


