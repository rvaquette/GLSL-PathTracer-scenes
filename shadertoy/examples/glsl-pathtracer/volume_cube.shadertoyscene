#define TMAX 50.0
#define LOOPMAX 100

vec2 opU(vec2 d1, vec2 d2) {
    return (d1.x < d2.x) ? d1 : d2;
}

float sdSphere(vec3 p, float r) {
    return length(p) - r;
}

float sdBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

vec2 map(vec3 pos) {
    vec2 res = vec2(1e10, 0.0);
    
    // Cube - using sdBox for the volume cube
    vec3 cubePos = vec3(0.0, 1.0, 0.0); // Default position
    float cube = sdBox(pos - cubePos, vec3(1.));
    res = opU(res, vec2(cube, 1.0)); // volume material
    
    // Plane (floor) - large flat box scaled 10x10x10
    vec3 planePos = vec3(0.0, 0., 0.0);
    vec3 planeScale = vec3(50.0, 0.1, 50.0); // Large floor plane
    float plane = sdBox(pos - planePos, planeScale);
    res = opU(res, vec2(plane, 2.0)); // black material
    
    return res;
}