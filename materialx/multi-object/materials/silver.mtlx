<?xml version="1.0"?>
<materialx version="1.38">
  <surfacematerial name="silver_surface" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="silver_standard_surface" />
  </surfacematerial>

  <standard_surface name="silver_standard_surface" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.80, 0.81, 0.83" />
    <input name="metalness" type="float" value="0.9" />
    <input name="specular_roughness" type="float" value="0.15" />
  </standard_surface>
</materialx>
