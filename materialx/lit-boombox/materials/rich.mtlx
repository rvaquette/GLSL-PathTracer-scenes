<?xml version="1.0"?>
<materialx version="1.38">
  <surfacematerial name="boombox_surface" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="boombox_standard_surface" />
  </surfacematerial>

  <standard_surface name="boombox_standard_surface" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.2, 0.2, 0.22" />
    <input name="metalness" type="float" value="0.65" />
    <input name="specular_roughness" type="float" value="0.18" />
  </standard_surface>
</materialx>
