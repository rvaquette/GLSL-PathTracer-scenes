<?xml version="1.0"?>
<materialx version="1.38">
  <nodegraph name="NG_demo">
    <image name="albedo_tex" type="color3">
      <input name="file" type="filename" value="robot_baseColor.png" />
      <input name="default" type="color3" value="0.8, 0.7, 0.6" />
    </image>
    <image name="detail_tex" type="color3">
      <input name="file" type="filename" value="robot_detail.png" />
      <input name="default" type="color3" value="0.2, 0.2, 0.2" />
    </image>
    <multiply name="albedo_mult" type="color3">
      <input name="in1" type="color3" nodename="albedo_tex" />
      <input name="in2" type="color3" nodename="detail_tex" />
    </multiply>
    <normalmap name="normal_map" type="vector3">
      <input name="file" type="filename" value="robot_normal.png" />
      <input name="default" type="color3" value="0.5, 0.5, 1.0" />
    </normalmap>
    <standard_surface name="demo_surface" type="surfaceshader">
      <input name="base_color" type="color3" nodename="albedo_mult" />
      <input name="normal" type="vector3" nodename="normal_map" />
      <input name="metalness" type="float" value="0.1" />
      <input name="specular_roughness" type="float" value="0.3" />
      <input name="subsurface" type="float" value="0.0" />
      <input name="transmission" type="float" value="0.0" />
    </standard_surface>
  </nodegraph>
</materialx>
