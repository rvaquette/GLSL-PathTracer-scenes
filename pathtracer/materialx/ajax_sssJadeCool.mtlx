<?xml version="1.0"?>
<materialx version="1.38">
  <nodegraph name="NG_ajax_sssJadeCool">
    <image name="jade_tex_a" type="color3">
      <input name="file" type="filename" value="robot_baseColor.png" />
      <input name="default" type="color3" value="0.56, 0.82, 0.72" />
    </image>
    <image name="jade_tex_b" type="color3">
      <input name="file" type="filename" value="robot_baseColor.png" />
      <input name="default" type="color3" value="0.64, 0.92, 0.82" />
    </image>
    <mix name="jade_mix" type="color3">
      <input name="bg" type="color3" nodename="jade_tex_a" />
      <input name="fg" type="color3" nodename="jade_tex_b" />
      <input name="mix" type="float" value="0.35" />
    </mix>
    <standard_surface name="jade_surface" type="surfaceshader">
      <input name="base_color" type="color3" nodename="jade_mix" />
      <input name="metalness" type="float" value="0.0" />
      <input name="specular_roughness" type="float" value="0.2" />
      <input name="subsurface" type="float" value="0.78" />
      <input name="subsurface_color" type="color3" value="0.64, 0.92, 0.82" />
      <input name="subsurface_scale" type="float" value="1.55" />
      <input name="transmission" type="float" value="0.26" />
      <input name="specular_IOR" type="float" value="1.55" />
      <input name="emission" type="float" value="0.0" />
      <input name="emission_color" type="color3" value="0.0, 0.0, 0.0" />
      <input name="opacity" type="float" value="1.0" />
    </standard_surface>
  </nodegraph>
</materialx>
