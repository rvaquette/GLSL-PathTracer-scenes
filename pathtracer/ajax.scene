renderer
{
	resolution 900 900
	maxdepth 2
	tilewidth 100
	tileheight 100
	envmapfile HDR/sunset.hdr
	envmapintensity 5.0
}

camera
{
	position 0.0 0.5 -1.8
	lookat 0 0.5 0.0
	fov 35
}

material silver
{
	color 1.0 1.0 1.0
	roughness 0.1
	metallic 1.0	
}

material gold
{
	color 1.0 0.71 0.29
	roughness 0.1
	metallic 1.0
	proceduralshaderglsl
	{
		// Ray-driven stylized anisotropic tint with edge glow.
		vec3 V = normalize(-ray.direction);
		vec3 N = normalize(normal);
		float ndotv = clamp(dot(N, V), 0.0, 1.0);
		float edge = pow(1.0 - ndotv, 3.0);
		float bands = 0.5 + 0.5 * sin((uv.x + uv.y) * 42.0 + pos.y * 3.0);

		vec3 baseA = vec3(1.0, 0.72, 0.25);
		vec3 baseB = vec3(0.95, 0.35, 0.08);
		mat.baseColor = mix(baseA, baseB, bands);

		mat.roughness = clamp(0.08 + edge * 0.35, 0.03, 0.7);
		mat.metallic = 1.0;
		mat.clearcoat = clamp(0.2 + edge * 0.5, 0.0, 1.0);
		mat.emission += vec3(1.0, 0.4, 0.1) * edge * 0.2;
	}
}

material proceduralEdgeWear
{
	color 0.65 0.66 0.68
	roughness 0.28
	metallic 1.0
	proceduralshaderglsl
	{
		vec3 V = normalize(-ray.direction);
		vec3 N = normalize(normal);
		float edge = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 4.0);
		float grunge = 0.5 + 0.5 * sin(pos.x * 16.0 + pos.y * 11.0 + pos.z * 13.0);
		float wear = clamp(edge * 0.9 + grunge * 0.25, 0.0, 1.0);

		vec3 baseMetal = vec3(0.35, 0.36, 0.38);
		vec3 polishedEdge = vec3(0.92, 0.9, 0.84);
		mat.baseColor = mix(baseMetal, polishedEdge, wear);
		mat.roughness = clamp(mix(0.55, 0.08, wear), 0.04, 0.8);
		mat.metallic = 1.0;
		mat.clearcoat = mix(0.1, 0.45, wear);
	}
}

material proceduralMarble
{
	color 0.82 0.84 0.88
	roughness 0.22
	metallic 0.0
	subsurface 0.72
	spectrans 0.22
	ior 1.49
	ssscolor 0.84 0.89 0.96
	sssdensity 1.35
	sssanisotropy 0.05
	proceduralshaderglsl
	{
		float flow = pos.x * 2.3 + pos.z * 2.1;
		float swirl = sin(flow + sin(pos.y * 5.0) * 1.2 + sin(pos.x * 7.0 + pos.z * 6.0) * 0.4);
		float veins = smoothstep(0.25, 0.85, 0.5 + 0.5 * swirl);
		float haze = 0.5 + 0.5 * sin((pos.x + pos.z) * 3.0 + pos.y * 2.0);

		vec3 stoneA = vec3(0.9, 0.92, 0.94);
		vec3 stoneB = vec3(0.68, 0.72, 0.78);
		vec3 stone = mix(stoneA, stoneB, haze * 0.4);
		vec3 veinColor = vec3(0.22, 0.24, 0.28);

		mat.baseColor = mix(stone, veinColor, veins * 0.75);
		mat.roughness = mix(0.14, 0.32, veins * 0.6);
		mat.metallic = 0.0;
		mat.clearcoat = 0.08;
	}
}

material sssMarbleDense
{
	materialgraphfile materialgraphs/ajax_sssMarbleDense.graph.json
	color 0.78 0.81 0.86
	roughness 0.28
	metallic 0.0
	subsurface 0.65
	spectrans 0.18
	ior 1.50
	ssscolor 0.80 0.86 0.95
	sssdensity 2.10
	sssanisotropy 0.08
	proceduralshaderglsl
	{
		float flow = pos.x * 2.3 + pos.z * 2.1;
		float swirl = sin(flow + sin(pos.y * 5.0) * 1.2 + sin(pos.x * 7.0 + pos.z * 6.0) * 0.4);
		float veins = smoothstep(0.2, 0.82, 0.5 + 0.5 * swirl);
		float haze = 0.5 + 0.5 * sin((pos.x + pos.z) * 3.0 + pos.y * 2.0);

		vec3 stoneA = vec3(0.86, 0.88, 0.92);
		vec3 stoneB = vec3(0.56, 0.60, 0.68);
		vec3 stone = mix(stoneA, stoneB, haze * 0.55);
		vec3 veinColor = vec3(0.14, 0.16, 0.20);

		mat.baseColor = mix(stone, veinColor, veins * 0.82);
		mat.roughness = mix(0.18, 0.38, veins * 0.65);
		mat.metallic = 0.0;
		mat.clearcoat = 0.06;
	}
}

material sssWaxWarm
{
	materialgraphfile materialgraphs/ajax_sssWaxWarm.graph.json
	color 0.93 0.80 0.62
	roughness 0.28
	metallic 0.0
	subsurface 0.90
	spectrans 0.35
	ior 1.44
	ssscolor 1.0 0.85 0.62
	sssdensity 0.95
	sssanisotropy 0.0
}

material sssJadeCool
{
	materialxfile materialx/ajax_sssJadeCool.mtlx
	color 0.56 0.82 0.72
	roughness 0.20
	metallic 0.0
	subsurface 0.78
	spectrans 0.26
	ior 1.55
	ssscolor 0.64 0.92 0.82
	sssdensity 1.55
	sssanisotropy 0.12
}

material proceduralCarbonFiber
{
	color 0.1 0.1 0.1
	roughness 0.22
	metallic 0.0
	proceduralshaderglsl
	{
		vec2 p = uv * 70.0;
		float warpX = 0.5 + 0.5 * sin(p.x + sin(p.y * 0.35) * 1.3);
		float warpY = 0.5 + 0.5 * sin(p.y + sin(p.x * 0.35) * 1.3);
		float weave = clamp(max(warpX, warpY), 0.0, 1.0);

		vec3 V = normalize(-ray.direction);
		vec3 N = normalize(normal);
		float grazing = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 2.0);

		vec3 dark = vec3(0.03, 0.03, 0.035);
		vec3 fiber = vec3(0.18, 0.19, 0.21);
		mat.baseColor = mix(dark, fiber, weave * 0.75 + grazing * 0.15);
		mat.roughness = clamp(mix(0.34, 0.14, weave) + grazing * 0.08, 0.08, 0.5);
		mat.metallic = 0.0;
		mat.clearcoat = 0.5;
	}
}

material redPlastic
{
	color 1.0 0.0 0.0
	roughness 0.01
	metallic 0.0
}

material white
{
	color 1.0 1.0 1.0
	roughness 0.01
	metallic 0.0
}

material black
{
	color 0.1 0.1 0.1
	roughness 0.01
	metallic 1.0
}

material glass
{
	color 1.0 1.0 1.0
	materialType 1.0
	ior 1.45
}

mesh
{
	file ajax/ajax.obj
	# Quick switch candidates: sssMarbleDense | sssWaxWarm | sssJadeCool | proceduralMarble
	material sssMarbleDense
}

