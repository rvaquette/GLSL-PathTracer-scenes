renderer
{
    resolution 256 256
    maxdepth 8
    tilewidth 32
    tileheight 32
}

camera
{
    position -0.05 1.05 3.58
    lookat -0.05 1.05 -0.06
    fov 45
}

material mtlx_test
{
    materialx_document ../materialx/Materials/nodes/absval/absval.mtlx
    materialx_surface M_absval
}

mesh
{
    name cube_onyx
    file material_test/cube.obj
    material mtlx_test
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.125 3.125 3.125
    position -3.500000 2.500000 0.500000
    v2 -1.500000 2.500000 0.500000
    v1 -3.500000 2.500000 -1.500000
    type quad
}
