# Case 01: file-based procedural material (checkerboard baseline)
renderer
{
    resolution 512 512
    maxdepth 6
    tilewidth 128
    tileheight 128
    enabletonemap false
}

camera
{
    position 7.5 5.0 7.0
    lookat 0.0 0.0 0.0
    fov 45
}

material proc_checker
{
    color 0.65 0.65 0.65
    roughness 0.35
    glsl_material_file ../../../shaders/procedural/mat_checkerboard.glsl
}

material ref_gray
{
    color 0.65 0.65 0.65
    roughness 0.35
}

material ground
{
    color 0.35 0.35 0.35
    roughness 0.85
}

mesh
{
    name proc_sphere
    file material_test/sphere.obj
    material proc_checker
    position -1.2 1.0 0.0
}

mesh
{
    name ref_sphere
    file material_test/sphere.obj
    material ref_gray
    position 1.2 1.0 0.0
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.0 3.0 3.0
    position -3.5 2.5 0.5
    v2 -1.5 2.5 0.5
    v1 -3.5 2.5 -1.5
    type quad
}
