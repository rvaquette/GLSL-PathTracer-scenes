# Case 02: inline one-liner (constant overrides)
renderer
{
    resolution 512 512
    maxdepth 6
    tilewidth 128
    tileheight 128
}

camera
{
    position 0.0 2.0 6.0
    lookat 0.0 1.0 0.0
    fov 40
}

material proc_inline_constant
{
    glsl_material_code = mat.baseColor = vec3(0.95, 0.15, 0.10); mat.roughness = 0.08; mat.metallic = 1.0; mat.ior = 1.5;
}

material ground
{
    color 0.35 0.35 0.35
    roughness 0.85
}

mesh
{
    name proc_sphere
    file material_test/sphere.obj
    material proc_inline_constant
    position 0.0 1.0 0.0
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.0 3.0 3.0
    position -3.5 2.5 0.5
    v2 -1.5 2.5 0.5
    v1 -3.5 2.5 -1.5
    type quad
}
