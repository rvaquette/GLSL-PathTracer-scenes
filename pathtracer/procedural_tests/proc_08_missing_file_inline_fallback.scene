# Case 08: missing glsl_material_file + inline fallback
renderer
{
    resolution 512 512
    maxdepth 8
    tilewidth 128
    tileheight 128
}

camera
{
    position 0.0 2.0 6.0
    lookat 0.0 1.0 0.0
    fov 40
}

material proc_missing_file
{
    glsl_material_file ../../../shaders/procedural/not_found_material.glsl
    glsl_material_code = mat.baseColor = vec3(0.15, 0.75, 0.25); mat.roughness = 0.45;
}

material proc_transmission
{
    glsl_material_file ../../../shaders/procedural/mat_transmission_debug.glsl
}

material ground
{
    color 0.35 0.35 0.35
    roughness 0.85
}

mesh
{
    name left_sphere
    file material_test/sphere.obj
    material proc_missing_file
    position -1.2 1.0 0.0
}

mesh
{
    name right_sphere
    file material_test/sphere.obj
    material proc_transmission
    position 1.2 1.0 0.0
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.0 3.0 3.0
    position -3.5 2.5 0.5
    v2 -1.5 2.5 0.5
    v1 -3.5 2.5 -1.5
    type quad
}
