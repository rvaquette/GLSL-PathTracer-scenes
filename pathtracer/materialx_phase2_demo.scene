renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    enabletonemap false
    bsdfbackend materialx
}

camera
{
    position 7.5 5 7
    lookat 0 0 0
    fov 45
}

material materialx_explicit
{
    color 0.82 0.32 0.12
    roughness 0.22
    metallic 0.0
    ior 1.45
    spectrans 0.65
    clearcoat 0.10
    sheen 0.15
    sheenTint 0.20

    materialx_model 1
    materialx_diffuse_weight 0.35
    materialx_specular_weight 0.30
    materialx_transmission_weight 0.25
    materialx_coat_weight 0.10
    materialx_roughness 0.18
    materialx_ior 1.52
    materialx_anisotropy 0.35
    materialx_sheen 0.20
    materialx_sheen_tint 0.30
    materialx_subsurface 0.05
}

material disney_fallback
{
    color 0.82 0.32 0.12
    roughness 0.22
    metallic 0.0
    ior 1.45
    spectrans 0.65
    clearcoat 0.10
    sheen 0.15
    sheenTint 0.20
}

material ground
{
    color 0.50 0.50 0.50
    roughness 0.55
    metallic 0.0
}

mesh
{
    name cube_explicit
    file material_test/cube.obj
    material materialx_explicit
}

mesh
{
    name sphere_fallback
    file material_test/sphere.obj
    material disney_fallback
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.125 3.125 3.125
    position -3.500000 2.500000 0.500000
    v2 -1.500000 2.500000 0.500000
    v1 -3.500000 2.500000 -1.500000
    type quad
}
