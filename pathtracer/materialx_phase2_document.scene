renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    enabletonemap false
    bsdfbackend materialx
}

camera
{
    position 7.5 5 7
    lookat 0 0 0
    fov 45
}

material materialx_from_doc
{
    materialx_document ../materialx/StandardSurface/standard_surface_gold.mtlx
    materialx_surface SR_gold
}

material fallback_ref
{
    color 0.82 0.32 0.12
    roughness 0.22
    metallic 0.0
    ior 1.45
    spectrans 0.65
    clearcoat 0.10
    sheen 0.15
    sheenTint 0.20
}

material ground
{
    color 0.50 0.50 0.50
    roughness 0.55
    metallic 0.0
}

mesh
{
    name cube_doc
    file material_test/cube.obj
    material materialx_from_doc
}

mesh
{
    name sphere_ref
    file material_test/sphere.obj
    material fallback_ref
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.125 3.125 3.125
    position -3.500000 2.500000 0.500000
    v2 -1.500000 2.500000 0.500000
    v1 -3.500000 2.500000 -1.500000
    type quad
}
