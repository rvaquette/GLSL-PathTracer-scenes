materialx_generator essl

renderer
{
    resolution 1280 720
    maxdepth 12
    tilewidth 256
    tileheight 144
    envmapfile HDR/san_giuseppe_bridge_2k.hdr
}

camera
{
    position 0 1.5 6
    lookat 0 0.5 0
    fov 40
}

material glass
{
    materialx_document ../materialx/materials/showcase/gltf_pbr/glass/glass.mtlx
    materialx_surface PBR_Glass
}

material ground
{
    color 0.55 0.55 0.55
    roughness 0.4
    metallic 0.0
}

mesh
{
    name glass_sphere
    file material_test/sphere.obj
    material glass
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
	emission 5.0 5.0 5.0
	#3.978 3.978 3.978
	position 1 5 1
	radius 1.0
	type sphere
}

light
{
	emission 3.125 3.125 3.125
	position -3.500000 2.500000 0.500000
	v2 -1.500000 2.500000 0.500000
	v1 -3.500000 2.500000 -1.500000
	type quad
}